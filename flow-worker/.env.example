# Local-only HTTP server. Do not bind this worker to 0.0.0.0.
FLOW_WORKER_HOST=127.0.0.1
FLOW_WORKER_PORT=4177

# Authentication Bearer Token:
# Managed automatically via PostgreSQL integration credentials and AES-256-GCM encryption.
# You do NOT need to configure this manually in .env.
# The backend and worker automatically negotiate a secure loopback handshake ticket.
# An optional override value can still be provided here if desired.
FLOW_WORKER_TOKEN=

# Browser channel: leave blank for bundled Chromium, or set to 'chrome' to use installed Google Chrome.
# FLOW_BROWSER_CHANNEL=chrome
FLOW_BROWSER_CHANNEL=

# Persistent browser profile directory.
# Default on Windows: %LOCALAPPDATA%\AIKidsContentStudio\GoogleFlowChromeProfile
# Default on macOS: ~/Library/Application Support/AIKidsContentStudio/GoogleFlowChromeProfile
# Default on Linux: ~/.config/ai-kids-content-studio/GoogleFlowChromeProfile
# Leave blank to use the OS-specific default path.
FLOW_PROFILE_DIR=

# Downloaded Flow assets are stored outside the repository by default.
FLOW_DOWNLOAD_DIR=

# Existing AI Kids Content Studio backend.
FLOW_BACKEND_URL=http://127.0.0.1:5001

# Optional selector override if Google Flow changes its prompt editor markup.
FLOW_PROMPT_SELECTOR=

# Comma-separated browser origins allowed to call this local worker.
# The worker still requires its bearer token for all non-health endpoints.
FLOW_WORKER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
