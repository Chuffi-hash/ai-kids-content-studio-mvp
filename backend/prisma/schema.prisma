// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Story {
  id             String           @id @default(cuid())
  storyId        String           @unique
  title          String
  logline        String
  lesson         String
  topic          String?
  ageGroup       String?
  audience       String?
  genre          String?
  visualStyle    String?
  targetDuration Int?
  visualBible    Json?
  flowProjectId  String?
  originalScript String?
  productionStage String?         @default("script")
  scenes         Scene[]
  storyCharacters StoryCharacter[]
  shots          Shot[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([storyId])
}

model Scene {
  id                    String         @id @default(cuid())
  sceneId               String         @unique
  storyId               String
  story                 Story          @relation(fields: [storyId], references: [storyId])
  title                 String
  number                Int
  order                 Int            @default(0)
  startMs               Int            @default(0)
  endMs                 Int            @default(0)
  narration             String
  visualPrompt          String?
  cameraDirection       String?
  characterIds          String?
  imageUrl              String?
  videoUrl              String?
  audioUrl              String?
  generationStatus      String         @default("draft")
  estimatedDurationMs   Int            @default(0)
  actualAudioDurationMs Int?
  generationError       String?
  animationData         Json?
  images                Image[]
  versions              SceneVersion[]
  shots                 Shot[]
  deletedAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([sceneId])
  @@index([storyId])
  @@index([deletedAt])
}

model SceneVersion {
  id              String   @id @default(cuid())
  sceneId         String
  scene           Scene    @relation(fields: [sceneId], references: [sceneId])
  versionNumber   Int      @default(1)
  prompt          String?
  narration       String?
  cameraDirection String?
  imageUrl        String?
  videoUrl        String?
  audioUrl        String?
  durationMs      Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([sceneId])
}

model Shot {
  id                    String    @id @default(cuid())
  shotId                String    @unique
  storyId               String
  story                 Story     @relation(fields: [storyId], references: [storyId])
  sceneId               String
  scene                 Scene     @relation(fields: [sceneId], references: [sceneId])
  number                Int
  order                 Int       @default(0)
  title                 String?
  description           String?
  durationMs            Int       @default(5000)
  shotType              String?
  cameraAngle           String?
  cameraMovement        String?
  lighting              String?
  shotDirection         Json?
  characterInstructions Json?
  backgroundPrompt      String?
  videoPrompt           String?
  promptHistory         Json?
  backgroundUrl         String?
  videoUrl              String?
  assetStatus           String    @default("pending")
  approvalStatus        String    @default("pending")
  productionStatus      String    @default("draft")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([shotId])
  @@index([sceneId])
  @@index([storyId])
}

model Image {
  id         String   @id @default(cuid())
  sceneId    String
  scene      Scene    @relation(fields: [sceneId], references: [sceneId])
  provider   String
  model      String
  prompt     String
  storageKey String
  imageUrl   String
  width      Int
  height     Int
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sceneId])
  @@index([status])
}

model Character {
  id                  String           @id @default(cuid())
  name                String
  species             String
  personality         String
  visualDescription   String
  distinctiveFeatures String
  isLocked            Boolean          @default(false)
  canonicalAppearance Json?
  referenceImageUrl   String?
  referenceImagePrompt String?
  storyCharacters     StoryCharacter[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([name])
}

model StoryCharacter {
  id          String     @id @default(cuid())
  storyId     String
  characterId String
  story       Story      @relation(fields: [storyId], references: [storyId])
  character   Character  @relation(fields: [characterId], references: [id])
  createdAt   DateTime   @default(now())

  @@unique([storyId, characterId])
  @@index([storyId])
  @@index([characterId])
}
