# Server Configuration
PORT=5001
FRONTEND_URL=http://localhost:5173
STORAGE_DIR=./storage
DATABASE_URL=postgresql://user:password@localhost:5432/ai_kids_studio
NODE_ENV=development

# Story Generation Provider
# Options: 'ollama' (default local), 'openai', 'deterministic' (for testing/offline fallback)
AI_STORY_PROVIDER=ollama
OLLAMA_MODEL=mistral
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# TTS Configuration
# Options: 'kokoro' (default local ONNX), 'fish_audio' (cloud API), 'google_tts'
DEFAULT_TTS_PROVIDER=kokoro
KOKORO_MODEL_DIR=./models/kokoro

# Fish Audio Configuration
# Sign up at https://fish.audio to obtain an API key (supports comma-separated keys or FISH_API_KEYS for rotation & failover)
FISH_API_KEY=
FISH_API_KEYS=
FISH_AUDIO_BASE_URL=https://api.fish.audio
# Model must be strictly the free developer tier model 's2.1-pro-free'
# Free access is time-limited through November 30, 2026 under fair-use terms
FISH_AUDIO_MODEL=s2.1-pro-free
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    RD6S 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    RD6S 
# Image Generation Configuration
# Options: 'pollinations' (free cloud default), 'comfyui' (local), 'huggingface', 'hosted'
IMAGE_PROVIDER=pollinations
POLLINATIONS_MODEL=flux
COMFYUI_URL=http://localhost:8188
HF_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
IMAGE_API_URL=
IMAGE_API_KEY=

# Video Generation & Assembly Configuration
# Options: 'ffmpeg' (default local video stitcher & renderer), 'ai', 'runway', 'replicate'
VIDEO_PROVIDER=ffmpeg
RUNWAY_API_KEY=
REPLICATE_API_TOKEN=
PYTHON_PATH=python