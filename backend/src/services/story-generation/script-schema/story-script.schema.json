{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aikidscontent.studio/schemas/story-script.1.0.json",
  "title": "AI Kids Content Studio Canonical Story Script",
  "description": "Standardized canonical JSON script schema for AI story generation, validation, and deterministic storyboard import.",
  "type": "object",
  "required": ["schemaVersion", "story", "characters", "scenes"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "story": {
      "type": "object",
      "required": ["title", "language"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "default": "Hindi" },
        "targetDurationSeconds": { "type": "number", "minimum": 10, "maximum": 600 },
        "genre": { "type": "string" },
        "targetAudience": { "type": "string" },
        "logline": { "type": "string" },
        "theme": { "type": "string" },
        "lesson": { "type": "string" },
        "visualStyle": { "type": "string" },
        "aspectRatio": {
          "type": "string",
          "enum": ["16:9", "9:16", "1:1", "4:5"],
          "default": "16:9"
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["characterKey", "name"],
        "properties": {
          "characterKey": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "species": { "type": "string" },
          "description": { "type": "string" },
          "appearance": { "type": ["string", "object"] },
          "clothing": { "type": "string" },
          "distinctiveFeatures": { "type": "string" },
          "personality": { "type": "string" },
          "voice": { "type": "string" }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sceneNumber", "title"],
        "properties": {
          "sceneNumber": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "durationSeconds": { "type": "number", "minimum": 2, "maximum": 120 },
          "summary": { "type": "string" },
          "location": { "type": "string" },
          "timeOfDay": { "type": "string" },
          "weather": { "type": "string" },
          "lighting": { "type": "string" },
          "charactersPresent": {
            "type": "array",
            "items": { "type": "string" }
          },
          "background": {
            "type": ["object", "string"],
            "properties": {
              "prompt": { "type": "string" },
              "style": { "type": "string" }
            }
          },
          "camera": {
            "type": ["object", "string"],
            "properties": {
              "direction": { "type": "string" },
              "perspective": { "type": "string" },
              "movement": { "type": "string" },
              "angle": { "type": "string" }
            }
          },
          "narration": { "type": "string" },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["speakerKey", "text"],
              "properties": {
                "speakerKey": { "type": "string" },
                "text": { "type": "string", "minLength": 1 },
                "emotion": { "type": "string" },
                "expression": { "type": "string" },
                "voice": { "type": "string" }
              }
            }
          },
          "characterActions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["characterKey", "action"],
              "properties": {
                "characterKey": { "type": "string" },
                "action": {
                  "type": "string",
                  "enum": ["idle", "walk", "wave", "jump", "point"]
                },
                "description": { "type": "string" }
              }
            }
          },
          "soundEffects": {
            "type": ["array", "string"],
            "items": { "type": "string" }
          },
          "visualEffects": {
            "type": ["array", "string"],
            "items": { "type": "string" }
          },
          "music": { "type": ["string", "object"] },
          "transitionOut": { "type": "string" },
          "onScreenText": { "type": "string" }
        }
      }
    },
    "globalContinuity": {
      "type": "object",
      "properties": {
        "visualGuidelines": { "type": "string" },
        "characterConsistency": { "type": "string" },
        "environmentNotes": { "type": "string" }
      }
    },
    "endScreen": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "callToAction": { "type": "string" },
        "channelBranding": { "type": "string" }
      }
    }
  }
}
