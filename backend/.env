# Server Configuration
PORT=5001
FRONTEND_URL=http://localhost:5173
STORAGE_DIR=./storage
DATABASE_URL=postgresql://postgres:Qwerty@1997@localhost:5433/ai-media-studio
NODE_ENV=development

# Story Generation Provider
# Options: 'ollama' (default local), 'openai', 'deterministic' (for testing/offline fallback)
AI_STORY_PROVIDER=ollama
OLLAMA_MODEL=mistral

# TTS Configuration
# Preferred provider: 'kokoro' (local ONNX) or 'fish_audio' (cloud API)
DEFAULT_TTS_PROVIDER=kokoro
KOKORO_MODEL_DIR=./models/kokoro

# Fish Audio Configuration
# Multiple comma-separated API keys supported for automatic round-robin rotation & rate-limit failover
FISH_API_KEY=sk-fish-0nlZwUpt7TvrccE4beKNE7R7qBWMHG9Lhq8L278r-7A,sk-fish-a0wnw0cMfRQoqcH_fp0v3IOu2Rtk2Q7m_bVKG9nDGBs
FISH_API_KEYS=sk-fish-0nlZwUpt7TvrccE4beKNE7R7qBWMHG9Lhq8L278r-7A,sk-fish-a0wnw0cMfRQoqcH_fp0v3IOu2Rtk2Q7m_bVKG9nDGBs
FISH_AUDIO_BASE_URL=https://api.fish.audio
# Model must be strictly the free developer tier model 's2.1-pro-free'
# Free access is time-limited through November 30, 2026 under fair-use terms
FISH_AUDIO_MODEL=s2.1-pro-free

# Image Generation Configuration
IMAGE_PROVIDER=pollinations
POLLINATIONS_MODEL=flux
COMFYUI_URL=http://127.0.0.1:8188
HF_TOKEN=hf_xxxxxxxxxxxxxxxxx
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_API_URL=
IMAGE_API_KEY=

# Video Generation & Assembly Configuration
VIDEO_PROVIDER=ffmpeg
PYTHON_PATH=python
